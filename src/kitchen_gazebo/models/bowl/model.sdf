<?xml version="1.0"?>
<!-- bowl from the lab (pycram resources/objects/bowl.stl, same mesh as in the CRAM repo).
     Visual: the lab mesh. Collision: a cylinder the size of the mesh's bounding box. -->
<sdf version="1.9">
  <model name="bowl">
    <link name="link">
      <inertial>
        <pose>0.0 -0.002 0.0015 0 0 0</pose>
        <mass>0.15</mass>
        <inertia><ixx>0.000298</ixx><iyy>0.000301</iyy><izz>0.000487</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="collision">
        <pose>0.0 -0.002 0.0015 0 0 0</pose>
        <geometry><cylinder><radius>0.070</radius><length>0.067</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><mesh><uri>model://bowl/meshes/bowl.stl</uri></mesh></geometry>
        <material><ambient>0.3 0.5 0.9 1</ambient><diffuse>0.3 0.5 0.9 1</diffuse></material>
      </visual>
    </link>
    <!-- Ground-truth pose for checking results (perception itself goes through the head camera). -->
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_link_pose>false</publish_link_pose>
      <publish_model_pose>true</publish_model_pose>
      <use_pose_vector_msg>true</use_pose_vector_msg>
      <update_frequency>20</update_frequency>
    </plugin>
  </model>
</sdf>
