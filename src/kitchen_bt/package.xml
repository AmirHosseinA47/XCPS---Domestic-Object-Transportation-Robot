<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>kitchen_bt</name>
  <version>0.1.0</version>
  <description>
    Behaviour tree (BehaviorTree.CPP v4) for setting and clearing the table with the PR2 in the
    Gazebo kitchen. Its actions call the robot skills (kitchen_skills.py); every step and its
    reason goes into an explanation log.
  </description>
  <maintainer email="amirhossein.ahrari@uni-oldenburg.de">Amirhossein Ahrari</maintainer>
  <license>TODO</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>behaviortree_cpp</depend>
  <depend>kitchen_interfaces</depend>
  <depend>ament_index_cpp</depend>
  <exec_depend>kitchen_gazebo</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
